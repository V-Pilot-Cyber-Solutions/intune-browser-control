{
  "schemaVersion": "1.0",
  "tenantKey": "digitrans",
  "organizationName": "DigiTrans",
  "tenantDomain": "digitrans.partners",
  "policyProfile": "Developer",
  "policyVersion": "DEV-9",
  "intuneDisplayName": "GitHub- Chrome and Edge Browser Control DEV-9",
  "intuneFileName": "DigiTrans-Browser-Control-Developer.ps1",
  "githubEnvironment": "digitrans-production",
  "execution": {
    "runAsAccount": "system",
    "runAs32Bit": false,
    "enforceSignatureCheck": false
  },
  "policyControls": {
    "defaultDeny": true,
    "downloadRestrictions": 0,
    "chromeCloudAPAuthEnabled": true,
    "chromeBrowserSigninDisabled": true,
    "chromeIncognitoDisabled": true,
    "edgeInPrivateDisabled": true,
    "personalGoogleRestrictionsEnabled": true
  },
  "configurationFiles": {
    "commonAllowlist": "config/common-allowlist.txt",
    "chromeOnlyAllowlist": "config/chrome-only-allowlist.txt",
    "edgeOnlyAllowlist": "config/edge-only-allowlist.txt",
    "googlePersonalBlocklist": "config/google-personal-blocklist.txt",
    "trustedDownloadOrigins": "config/trusted-download-origins.txt",
    "oracleCookieSites": "config/oracle-cookie-sites.txt"
  }
}
